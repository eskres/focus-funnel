# Copy to .env and fill in the values. Never commit .env.

# --- Auth0 (used by the Next.js frontend) ---
# Tenant domain, without https://, e.g. your-tenant.eu.auth0.com
AUTH0_DOMAIN=
# Regular Web App credentials from the Auth0 dashboard
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Random 32-byte hex string for session cookie encryption: openssl rand -hex 32
AUTH0_SECRET=
# Public URL of the frontend (Auth0 callback and logout URLs are based on it)
APP_BASE_URL=http://localhost:3000

# --- Auth0 (shared by frontend and backend) ---
# Identifier of the Auth0 API that represents FastAPI; becomes the token audience
AUTH0_AUDIENCE=https://api.focus-funnel.local

# --- Backend ---
# Async SQLAlchemy URL. Compose uses the "postgres" service host name.
DATABASE_URL=postgresql+asyncpg://focus_funnel:focus_funnel@postgres:5432/focus_funnel
# 32 random bytes, base64-encoded, encrypts stored Nebius keys: openssl rand -base64 32
KEY_ENCRYPTION_KEY=
# Nebius Token Factory OpenAI-compatible API
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# ChromaDB server (unused until the thought-storage change)
CHROMA_URL=http://chroma:8000

# --- Frontend ---
# Where the Next.js server proxy forwards API calls (compose network address)
BACKEND_URL=http://backend:8000

# --- Postgres container ---
POSTGRES_USER=focus_funnel
POSTGRES_PASSWORD=focus_funnel
POSTGRES_DB=focus_funnel
