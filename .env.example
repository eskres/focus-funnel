# Copy to .env and fill in the values, or run scripts/init-env.sh, which
# copies it and sets new random secrets (docs/setup.md). Never commit .env.

# --- Login ---
# How people log in. One of:
#   oidc      any OpenID Connect provider (Pocket ID, Authentik, Keycloak, Auth0, ...)
#   firebase  a Firebase project
#   demo      no login; anonymous visitors whose data expires (public demo only)
# The frontend and the backend both refuse to start without it.
AUTH_MODE=
# Seals the frontend's session cookies, in every mode: openssl rand -hex 32
SESSION_SECRET=
# Public URL of the frontend. The OIDC callback and logout URLs are based on it.
APP_BASE_URL=http://localhost:3000
# Optional, oidc and firebase: comma-separated addresses and @domain entries,
# for example "ana@example.org,@example.com". Only users whose provider says
# their address is verified get in. Leave empty to let in anyone the provider
# logs in.
AUTH_ALLOWED_EMAILS=

# --- oidc mode (leave empty in the other modes) ---
# The issuer URL exactly as the provider's ID tokens carry it ("iss").
OIDC_ISSUER=
# The client registered at the provider. Callback URL: <APP_BASE_URL>/auth/callback
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Optional. Default: openid email profile offline_access
OIDC_SCOPES=
# Optional. The address the containers use to reach the provider when the
# public issuer URL is not reachable from inside compose, e.g. http://pocket-id:1411.
# It replaces the issuer's origin for discovery, keys, and token calls; the
# token's "iss" is still checked against OIDC_ISSUER.
OIDC_INTERNAL_URL=

# --- firebase mode (leave empty in the other modes) ---
# From the Firebase console, Project settings > Your apps > Web app config.
# The web API key is public by design; no service account is needed.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=

# --- Pocket ID (docker-compose.pocket-id.yml only) ---
# 32 random bytes, base64-encoded, encrypts Pocket ID's data: openssl rand -base64 32
POCKET_ID_ENCRYPTION_KEY=
# The address browsers use for Pocket ID; also OIDC_ISSUER. Passkeys need
# localhost or HTTPS (see docs/login.md for a Caddy example).
POCKET_ID_APP_URL=http://localhost:1411
# Set to true when Pocket ID runs behind an HTTPS reverse proxy.
POCKET_ID_TRUST_PROXY=false

# --- demo mode (ignored in the other modes) ---
# Demo mode refuses to start when any OIDC_* or FIREBASE_* value above is set,
# or when ALLOW_CUSTOM_PROVIDER=true or MCP_ENABLED=true is set. It runs one
# frontend instance.
# Hours until an anonymous visitor and all their data are deleted.
DEMO_SESSION_TTL_HOURS=24
# A visitor's API key is forgotten after this many idle minutes, or this many
# hours after it was saved, whichever comes first.
DEMO_KEY_TTL_MINUTES=30
DEMO_KEY_MAX_HOURS=4
# Requests per minute per client address.
DEMO_RATE_LIMIT=60
# New demo sessions per hour per client address.
DEMO_NEW_SESSIONS_PER_HOUR=5
# Live demo sessions at once.
DEMO_MAX_SESSIONS=500
# Set to true only behind a reverse proxy that sets X-Forwarded-For; the
# client address is then its last hop.
TRUSTED_PROXY=false

# --- Backend ---
# Async SQLAlchemy URL. Compose uses the "postgres" service host name.
DATABASE_URL=postgresql+asyncpg://focus_funnel:focus_funnel@postgres:5432/focus_funnel
# 32 random bytes, base64-encoded, encrypts stored provider keys: openssl rand -base64 32
KEY_ENCRYPTION_KEY=
# Embedding model for thought search, called with each user's own key for
# this preset provider (not custom). Changing it affects new search indexes
# only; rebuild existing ones with `python -m app.reembed --all`. See
# docs/search.md. EMBEDDING_DIMENSIONS shortens vectors for models that can;
# "native" keeps a model's full vectors. Empty values use the defaults below.
EMBEDDING_PROVIDER=nebius
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_DIMENSIONS=256
# Provider presets (base URL, key link, notice, capabilities) live in
# backend/app/providers.yaml; PROVIDERS_CONFIG_PATH overrides which file is read.
# PROVIDERS_CONFIG_PATH=
# Set to false to refuse a user-supplied base URL. Leave it unset in demo mode,
# which turns the custom provider off by itself.
ALLOW_CUSTOM_PROVIDER=
# The setup wizard at the app's /setup (default on; demo mode turns it off).
# Set to false to skip it, for example in an install set up from this file.
SETUP_WIZARD=

# --- MCP connectors (see docs/connectors.md) ---
# true lets the chat use tools from MCP servers; default off, refused in demo mode.
MCP_ENABLED=
# true lets users add MCP servers of their own (the backend then calls any URL).
MCP_USER_CONNECTORS=
# Your connectors and the catalog; empty reads backend/app/connectors.yaml.
MCP_CONNECTORS_PATH=
# Also set any variable a connector's auth.env names there, e.g. GCAL_MCP_TOKEN.

# --- Frontend ---
# Where the Next.js server proxy forwards API calls (compose network address)
BACKEND_URL=http://backend:8000

# --- Postgres container ---
POSTGRES_USER=focus_funnel
POSTGRES_PASSWORD=focus_funnel
POSTGRES_DB=focus_funnel
