# Fixed, test-only values for the offline check (scripts/offline-check.sh).
# Every compose call of the check reads this file instead of the project's
# .env, so an operator's settings never reach it. None of these is a secret.
POSTGRES_USER=focus_funnel
POSTGRES_PASSWORD=offline-check
POSTGRES_DB=focus_funnel
DATABASE_URL=postgresql+asyncpg://focus_funnel:offline-check@postgres:5432/focus_funnel
BACKEND_URL=http://backend:8000
